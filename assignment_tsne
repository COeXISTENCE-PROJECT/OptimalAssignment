#!/bin/bash
#SBATCH --job-name=tsne_10k_assignment_ttt
#SBATCH --partition=rknodes
#SBATCH --nodelist=bonk
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --output=slurm-%j.out
#SBATCH --qos=big_bonk

set -euo pipefail

PYTHON=/home/drozd/miniconda/envs/wavenet_env/bin/python

$PYTHON <<'PY'
from pathlib import Path
import csv
import numpy as np
import matplotlib.pyplot as plt

from sklearn.decomposition import PCA
from sklearn.manifold import TSNE
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

MANIFEST = Path("/scratch/tmp/drozd/4k_dirichlet_dataset/dataset_assignment_ttt_manifest.csv")
OUT_DIR = Path("/scratch/tmp/drozd/4k_dirichlet_dataset/tsne_3d")
OUT_DIR.mkdir(parents=True, exist_ok=True)

BINS = 200
PCA_DIM = 100
PERPLEXITY = 50
RANDOM_STATE = 42
N_CLUSTERS = 8

def parse_shape(s):
    return tuple(map(int, s.split("x")))

def load_manifest(path):
    rows = []
    with open(path, newline="") as f:
        reader = csv.DictReader(f)
        for r in reader:
            rows.append({
                "exp_id": int(r["exp_id"]),
                "assignment_path": r["assignment_path"],
                "assignment_shape": parse_shape(r["assignment_shape"]),
                "total_travel_time": float(r["total_travel_time"]),
            })
    return rows

def detect_time_axis(shapes):
    dim0 = [s[0] for s in shapes]
    dim1 = [s[1] for s in shapes]

    dim0_var = len(set(dim0))
    dim1_var = len(set(dim1))

    if dim0_var == 1 and dim1_var > 1:
        return 1   # N x T
    if dim1_var == 1 and dim0_var > 1:
        return 0   # T x N

    raise ValueError(
        f"Cannot detect time axis. "
        f"unique dim0={dim0_var}, unique dim1={dim1_var}"
    )

def bin_time(mat, time_axis, bins):
    # output: N x bins
    if time_axis == 0:
        mat = mat.T

    # now mat is N x T
    N, T = mat.shape
    out = np.zeros((N, bins), dtype=np.float32)

    splits = np.array_split(np.arange(T), bins)

    for j, idx in enumerate(splits):
        if len(idx) > 0:
            out[:, j] = mat[:, idx].sum(axis=1)

    return out

def make_assignment_features(rows, time_axis):
    X = []

    for k, r in enumerate(rows):
        a = np.load(r["assignment_path"], mmap_mode="r")
        binned = bin_time(a, time_axis=time_axis, bins=BINS)

        # klasyczna wersja: porównujemy macierze po ujednoliceniu czasu
        # log1p stabilizuje bardzo duże wartości
        feat = np.log1p(binned).ravel()
        X.append(feat)

        if (k + 1) % 500 == 0:
            print(f"Loaded assignment features: {k + 1}/{len(rows)}")

    return np.stack(X).astype(np.float32)

def run_tsne(X, metric="euclidean", precomputed=False):
    kwargs = dict(
        n_components=3,
        perplexity=PERPLEXITY,
        learning_rate="auto",
        init="random" if precomputed else "pca",
        metric=metric,
        random_state=RANDOM_STATE,
        verbose=1,
    )

    try:
        return TSNE(max_iter=1000, **kwargs).fit_transform(X)
    except TypeError:
        return TSNE(n_iter=1000, **kwargs).fit_transform(X)

def save_embedding_csv(path, rows, emb, clusters=None):
    with open(path, "w", newline="") as f:
        fieldnames = ["exp_id", "x", "y","z", "total_travel_time"]
        if clusters is not None:
            fieldnames.append("cluster")

        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()

        for i, r in enumerate(rows):
            row = {
                "exp_id": r["exp_id"],
                "x": float(emb[i, 0]),
                "y": float(emb[i, 1]),
                "z": float(emb[i, 2]),
                "total_travel_time": r["total_travel_time"],
            }
            if clusters is not None:
                row["cluster"] = int(clusters[i])

            writer.writerow(row)

def plot_embedding(path, emb, color, title, colorbar_label):
    plt.figure(figsize=(9, 7))
    sc = plt.scatter(
        emb[:, 0],
        emb[:, 1],
        c=color,
        s=8,
        alpha=0.85,
    )
    plt.colorbar(sc, label=colorbar_label)
    plt.title(title)
    plt.xlabel("t-SNE 1")
    plt.ylabel("t-SNE 2")
    plt.tight_layout()
    plt.savefig(path, dpi=200)
    plt.close()

def plot_clusters(path, emb, clusters, title):
    plt.figure(figsize=(9, 7))
    sc = plt.scatter(
        emb[:, 0],
        emb[:, 1],
        c=clusters,
        s=8,
        alpha=0.85,
    )
    plt.colorbar(sc, label="cluster")
    plt.title(title)
    plt.xlabel("t-SNE 1")
    plt.ylabel("t-SNE 2")
    plt.tight_layout()
    plt.savefig(path, dpi=200)
    plt.close()

rows = load_manifest(MANIFEST)
rows = sorted(rows, key=lambda r: r["exp_id"])

y = np.array([r["total_travel_time"] for r in rows], dtype=np.float64)
shapes = [r["assignment_shape"] for r in rows]

print(f"Samples: {len(rows)}")
print(f"TT min/mean/max: {y.min():.3f} / {y.mean():.3f} / {y.max():.3f}")

time_axis = detect_time_axis(shapes)
print(f"Detected time axis: {time_axis}")

# ============================================================
# 1. assignment-based t-SNE
# ============================================================

X = make_assignment_features(rows, time_axis=time_axis)

print("Raw feature matrix:", X.shape)

X = StandardScaler().fit_transform(X)

pca_dim = min(PCA_DIM, X.shape[0] - 1, X.shape[1])
X_pca = PCA(
    n_components=pca_dim,
    random_state=RANDOM_STATE,
).fit_transform(X)

print("PCA feature matrix:", X_pca.shape)

clusters = KMeans(
    n_clusters=N_CLUSTERS,
    random_state=RANDOM_STATE,
    n_init="auto",
).fit_predict(X_pca)

emb_assignment = run_tsne(X_pca, metric="euclidean", precomputed=False)

save_embedding_csv(
    OUT_DIR / "tsne_assignment_metric.csv",
    rows,
    emb_assignment,
    clusters=clusters,
)

plot_embedding(
    OUT_DIR / "tsne_assignment_colored_by_ttt.png",
    emb_assignment,
    y,
    "Assignment-based t-SNE colored by total travel time",
    "total travel time",
)

plot_clusters(
    OUT_DIR / "tsne_assignment_colored_by_cluster.png",
    emb_assignment,
    clusters,
    "Assignment-based t-SNE colored by KMeans cluster",
)

# cluster summary
with open(OUT_DIR / "cluster_ttt_summary.csv", "w", newline="") as f:
    writer = csv.DictWriter(
        f,
        fieldnames=[
            "cluster",
            "count",
            "tt_mean",
            "tt_median",
            "tt_min",
            "tt_max",
        ],
    )
    writer.writeheader()

    for c in sorted(set(clusters)):
        vals = y[clusters == c]
        writer.writerow({
            "cluster": int(c),
            "count": int(len(vals)),
            "tt_mean": float(vals.mean()),
            "tt_median": float(np.median(vals)),
            "tt_min": float(vals.min()),
            "tt_max": float(vals.max()),
        })

# ============================================================
# 2. TT-based t-SNE
# ============================================================

y_scaled = (y - y.mean()) / (y.std() + 1e-12)
D_ttt = np.abs(y_scaled[:, None] - y_scaled[None, :]).astype(np.float32)

emb_ttt = run_tsne(D_ttt, metric="precomputed", precomputed=True)

save_embedding_csv(
    OUT_DIR / "tsne_ttt_metric.csv",
    rows,
    emb_ttt,
    clusters=None,
)

plot_embedding(
    OUT_DIR / "tsne_ttt_metric_colored_by_ttt.png",
    emb_ttt,
    y,
    "TT-based t-SNE colored by total travel time",
    "total travel time",
)

print("Saved outputs to:", OUT_DIR)
print("Main files:")
print(" - tsne_assignment_colored_by_ttt.png")
print(" - tsne_assignment_colored_by_cluster.png")
print(" - tsne_ttt_metric_colored_by_ttt.png")
print(" - tsne_assignment_metric.csv")
print(" - tsne_ttt_metric.csv")
print(" - cluster_ttt_summary.csv")
PY
