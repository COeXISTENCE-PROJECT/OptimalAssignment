# ============================================================
# Parameters
# ============================================================

BINS = 200
PCA_DIM = 100
RANDOM_STATE = 42
N_CLUSTERS = 8

# UMAP
UMAP_N_NEIGHBORS = 50
UMAP_MIN_DIST = 0.05
UMAP_METRIC = "euclidean"

# PaCMAP
PACMAP_N_NEIGHBORS = 50
PACMAP_MN_RATIO = 0.5
PACMAP_FP_RATIO = 2.0
PACMAP_METRIC = "euclidean"

# Plotting
POINT_SIZE_2D = 8
POINT_SIZE_3D_STATIC = 8
POINT_SIZE_3D_INTERACTIVE = 3
ALPHA = 0.85


# ============================================================
# Data utilities
# ============================================================

def parse_shape(s):
    return tuple(map(int, s.split("x")))


def load_manifest(path):
    rows = []

    with open(path, newline="") as f:
        reader = csv.DictReader(f)

        for r in reader:
            rows.append({
                "exp_id": int(r["exp_id"]),
                "assignment_path": r["assignment_path"],
                "assignment_shape": parse_shape(r["assignment_shape"]),
                "total_travel_time": float(r["total_travel_time"]),
            })

    return rows


def detect_time_axis(shapes):
    dim0 = [s[0] for s in shapes]
    dim1 = [s[1] for s in shapes]

    dim0_var = len(set(dim0))
    dim1_var = len(set(dim1))

    if dim0_var == 1 and dim1_var > 1:
        return 1

    if dim1_var == 1 and dim0_var > 1:
        return 0

    if dim0_var == 1 and dim1_var == 1:
        shape = shapes[0]

        if shape[1] == BINS:
            return 1

        if shape[0] == BINS:
            return 0

        print(
            f"Warning: both axes are constant, shape={shape}. "
            f"Assuming time_axis=1, i.e. matrix is N x T."
        )
        return 1

    raise ValueError(
        f"Cannot detect time axis. "
        f"unique dim0={dim0_var}, unique dim1={dim1_var}"
    )


def bin_time(mat, time_axis, bins):
    """
    Input:
        mat: assignment matrix
    Output:
        N x bins

    Zakładamy, że po ewentualnej transpozycji:
        N = liczba ścieżek / agentów / relacji
        T = liczba kroków czasu
    """
    if time_axis == 0:
        mat = mat.T

    n_rows, T = mat.shape
    out = np.zeros((n_rows, bins), dtype=np.float32)

    splits = np.array_split(np.arange(T), bins)

    for j, idx in enumerate(splits):
        if len(idx) > 0:
            out[:, j] = mat[:, idx].sum(axis=1)

    return out


def make_assignment_features(rows, time_axis):
    X = []

    for k, r in enumerate(rows):
        a = np.load(r["assignment_path"], mmap_mode="r")
        binned = bin_time(a, time_axis=time_axis, bins=BINS)

        # Surowe wartości.
        feat = binned.ravel()

        # Alternatywa, jeśli wartości mają duży zakres:
        # feat = np.log1p(binned).ravel()

        X.append(feat)

        if (k + 1) % 500 == 0:
            print(f"Loaded assignment features: {k + 1}/{len(rows)}")

    return np.stack(X).astype(np.float32)


# ============================================================
# Models
# ============================================================

def run_kmeans(X):
    print("Running KMeans...")
    print(f"KMeans input shape: {X.shape}")
    print(f"KMeans n_clusters: {N_CLUSTERS}")

    try:
        labels = KMeans(
            n_clusters=N_CLUSTERS,
            random_state=RANDOM_STATE,
            n_init="auto",
        ).fit_predict(X)
    except TypeError:
        labels = KMeans(
            n_clusters=N_CLUSTERS,
            random_state=RANDOM_STATE,
            n_init=10,
        ).fit_predict(X)

    return labels.astype(int)


def run_umap(X, n_components, title_prefix):
    n_neighbors = min(UMAP_N_NEIGHBORS, X.shape[0] - 1)

    print(f"Running UMAP: {title_prefix}")
    print(f"UMAP input shape: {X.shape}")
    print(f"UMAP n_components: {n_components}")
    print(f"UMAP n_neighbors: {n_neighbors}")
    print(f"UMAP min_dist: {UMAP_MIN_DIST}")
    print(f"UMAP metric: {UMAP_METRIC}")

    reducer = umap.UMAP(
        n_components=n_components,
        n_neighbors=n_neighbors,
        min_dist=UMAP_MIN_DIST,
        metric=UMAP_METRIC,
        random_state=RANDOM_STATE,
        verbose=True,
    )

    emb = reducer.fit_transform(X)
    return np.asarray(emb, dtype=np.float32)


def run_pacmap(X, n_components, title_prefix):
    n_neighbors = min(PACMAP_N_NEIGHBORS, X.shape[0] - 1)

    print(f"Running PaCMAP: {title_prefix}")
    print(f"PaCMAP input shape: {X.shape}")
    print(f"PaCMAP n_components: {n_components}")
    print(f"PaCMAP n_neighbors: {n_neighbors}")
    print(f"PaCMAP MN_ratio: {PACMAP_MN_RATIO}")
    print(f"PaCMAP FP_ratio: {PACMAP_FP_RATIO}")
    print(f"PaCMAP metric: {PACMAP_METRIC}")

    try:
        reducer = pacmap.PaCMAP(
            n_components=n_components,
            n_neighbors=n_neighbors,
            MN_ratio=PACMAP_MN_RATIO,
            FP_ratio=PACMAP_FP_RATIO,
            distance=PACMAP_METRIC,
            random_state=RANDOM_STATE,
            apply_pca=False,
            verbose=True,
        )
    except TypeError:
        try:
            reducer = pacmap.PaCMAP(
                n_components=n_components,
                n_neighbors=n_neighbors,
                MN_ratio=PACMAP_MN_RATIO,
                FP_ratio=PACMAP_FP_RATIO,
                distance=PACMAP_METRIC,
                random_state=RANDOM_STATE,
                apply_pca=False,
            )
        except TypeError:
            reducer = pacmap.PaCMAP(
                n_components=n_components,
                n_neighbors=n_neighbors,
                MN_ratio=PACMAP_MN_RATIO,
                FP_ratio=PACMAP_FP_RATIO,
                distance=PACMAP_METRIC,
            )

    # PCA init działa tylko wtedy, gdy liczba cech >= liczba komponentów.
    init_mode = "pca" if X.shape[1] >= n_components else "random"
    print(f"PaCMAP init mode: {init_mode}")

    try:
        emb = reducer.fit_transform(X, init=init_mode)
    except TypeError:
        emb = reducer.fit_transform(X)

    return np.asarray(emb, dtype=np.float32)


# ============================================================
# Saving
# ============================================================

def save_embedding_csv(path, rows, emb, clusters=None):
    fieldnames = ["exp_id", "x", "y"]

    if emb.shape[1] >= 3:
        fieldnames.append("z")

    fieldnames.append("total_travel_time")

    if clusters is not None:
        fieldnames.append("cluster")

    with open(path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()

        for i, r in enumerate(rows):
            row = {
                "exp_id": r["exp_id"],
                "x": float(emb[i, 0]),
                "y": float(emb[i, 1]),
                "total_travel_time": r["total_travel_time"],
            }

            if emb.shape[1] >= 3:
                row["z"] = float(emb[i, 2])

            if clusters is not None:
                row["cluster"] = int(clusters[i])

            writer.writerow(row)


def save_cluster_summary(path, y, clusters):
    with open(path, "w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=[
                "cluster",
                "count",
                "tt_mean",
                "tt_median",
                "tt_min",
                "tt_max",
            ],
        )
        writer.writeheader()

        for c in sorted(set(clusters)):
            vals = y[clusters == c]

            writer.writerow({
                "cluster": int(c),
                "count": int(len(vals)),
                "tt_mean": float(vals.mean()),
                "tt_median": float(np.median(vals)),
                "tt_min": float(vals.min()),
                "tt_max": float(vals.max()),
            })


def save_pca_summary(path, pca):
    with open(path, "w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=[
                "component",
                "explained_variance_ratio",
                "cumulative_explained_variance_ratio",
            ],
        )
        writer.writeheader()

        cumulative = np.cumsum(pca.explained_variance_ratio_)

        for i, (evr, cum) in enumerate(zip(pca.explained_variance_ratio_, cumulative), start=1):
            writer.writerow({
                "component": i,
                "explained_variance_ratio": float(evr),
                "cumulative_explained_variance_ratio": float(cum),
            })


