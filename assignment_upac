def make_interactive_df(rows, emb, y, clusters=None):
    data = {
        "exp_id": [r["exp_id"] for r in rows],
        "component_1": emb[:, 0],
        "component_2": emb[:, 1],
        "total_travel_time": y,
    }

    if emb.shape[1] >= 3:
        data["component_3"] = emb[:, 2]

    if clusters is not None:
        data["cluster"] = clusters.astype(str)

    return pd.DataFrame(data)


def plot_embedding_2d_interactive_ttt(path, rows, emb, y, clusters, title):
    df = make_interactive_df(rows, emb, y, clusters=clusters)

    fig = px.scatter(
        df,
        x="component_1",
        y="component_2",
        color="total_travel_time",
        hover_data=["exp_id", "total_travel_time", "cluster"],
        title=title,
        render_mode="webgl",
    )

    fig.update_traces(
        marker=dict(
            size=5,
            opacity=ALPHA,
        )
    )

    fig.update_layout(
        xaxis_title="component 1",
        yaxis_title="component 2",
    )

    fig.write_html(str(path), include_plotlyjs=True, full_html=True)


