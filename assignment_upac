print("Running PCA...")
print(f"PCA input shape: {X_scaled.shape}")
print(f"PCA n_components: {pca_dim}")

pca = PCA(
    n_components=pca_dim,
    random_state=RANDOM_STATE,
)

X_pca = pca.fit_transform(X_scaled).astype(np.float32)

